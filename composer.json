{
    "name": "erp-city/erp-city-client",
    "description": "ERP client integration for Laravel apps",
    "version": "1.0.6",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0",
        "illuminate/mail": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/session": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "ERPClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ERPClient\\ERPClientServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
